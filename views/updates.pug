
doctype html
html
    head
        title= title
        meta(name="viewport", content="width=device-width, initial-scale=1")
        link(rel="stylesheet", href="/css/style.css")

    body
        h1 Add New HubSpot Contact

        a(href="/") Return to the homepage

        form(action="/update-cobj", method="POST")
            label(for="firstname") First Name
            input(type="text", name="firstname", id="firstname", required)

            label(for="lastname") Last Name
            input(type="text", name="lastname", id="lastname", required)

            label(for="email") Email
            input(type="email", name="email", id="email", required)

            label(for="test_name") Name
            input(type="text", name="test_name", id="test_name", required)

            label(for="test_category") Category
            input(type="text", name="test_category", id="test_category", required)

            label(for="test_status") Status
            input(type="text", name="test_status", id="test_status", required)

            button(type="submit") Create Contact
